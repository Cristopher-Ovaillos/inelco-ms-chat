PORT=3000
NODE_ENV=development
API_PREFIX=/api

#niveles: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
#si se define (ej: logs/app.log) los logs tambien se guardan en ese archivo
LOG_FILE=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
#si es true y la bd no responde el server no arranca. por defecto solo es true en production
DB_REQUIRED=false

#en duda si implementar una ia
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

#usuario y clave de /api-docs, sin estos dos la ruta no se monta
SWAGGER_USER=tu_usuario
SWAGGER_PASSWORD=clave
SWAGGER_TITLE=
SWAGGER_DESCRIPTION=
SWAGGER_VERSION=1.0.0
#vacio = http://localhost:PORT + API_PREFIX
SWAGGER_SERVER_URL=
